{
  "name": "smart-tro",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/__tests__/*.test.mjs && jest --runInBand",
    "test:coverage": "node --test --experimental-test-coverage scripts/__tests__/*.test.mjs && jest --runInBand --coverage",
    "verify:review-auth-config": "node scripts/review-auth-config.mjs",
    "verify:product-bundle": "node scripts/assert-product-bundle.mjs dist",
    "export:web": "expo export --platform web --clear && node scripts/write-pages-fallback.mjs",
    "test:web": "EXPO_PUBLIC_UI_PILOT= npm run export:web && npm run verify:product-bundle && playwright test",
    "test:web:ui-pilot": "EXPO_PUBLIC_UI_PILOT=true npm run export:web && UI_PILOT_REVIEW=true playwright test tests/web/ui-pilot.spec.ts",
    "test:web:auth": "EXPO_PUBLIC_API_BASE_URL=https://auth-fixture.invalid EXPO_PUBLIC_AUTH_USE_MOCK=false EXPO_PUBLIC_REVIEW_SOCIALS=true npm run export:web && AUTH_VISUAL_REVIEW=true AUTH_CHANGE_EMAIL_REVIEW=true AUTH_TOUCH_TARGET_REVIEW=true AUTH_SIGNUP_FLOW_REVIEW=true AUTH_DEEP_LINK_REVIEW=true AUTH_PASSWORD_RADIUS_REVIEW=true AUTH_PRESSED_REVIEW=true playwright test tests/web/auth-visual.spec.ts tests/web/auth-change-email.spec.ts tests/web/auth-touch-target.spec.ts tests/web/auth-signup-flow.spec.ts tests/web/auth-deep-link.spec.ts tests/web/auth-password-radius.spec.ts tests/web/auth-pressed.spec.ts"
  },
  "dependencies": {
    "@ant-design/icons-react-native": "^2.3.2",
    "@ant-design/react-native": "5.4.3",
    "@expo-google-fonts/be-vietnam-pro": "^0.4.1",
    "@expo/metro-runtime": "~5.0.5",
    "@expo/vector-icons": "^14.1.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "expo": "^53.0.20",
    "expo-asset": "~11.1.7",
    "expo-font": "~13.3.2",
    "expo-linear-gradient": "~14.1.5",
    "expo-secure-store": "~14.2.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.0.10",
    "@types/react-test-renderer": "^19.0.0",
    "eslint": "^9.31.0",
    "eslint-config-expo": "^9.2.0",
    "jest": "^29.7.0",
    "jest-expo": "^53.0.9",
    "react-test-renderer": "^19.0.0",
    "typescript": "~5.8.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "moduleNameMapper": {
      "^@ant-design/react-native$": "<rootDir>/test/mocks/ant-design-react-native.tsx"
    },
