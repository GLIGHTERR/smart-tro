# Public renter API base URL. Do not include a trailing slash or credentials.
EXPO_PUBLIC_API_BASE_URL=https://smart-platform-renter-api.onrender.com
EXPO_PUBLIC_REVIEW_SOCIALS=true
# Enables the FE-only UC-03 review flow. Production must keep this false.
EXPO_PUBLIC_UC03_REVIEW=true
# Local and automated tests only. Review/production builds must leave this false.
EXPO_PUBLIC_AUTH_USE_MOCK=false
